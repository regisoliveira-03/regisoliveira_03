import streamlit as st
import spacy
import pandas as pd
from pyvis.network import Network
import streamlit.components.v1 as components

# 1. Configuração da Página
st.set_page_config(page_title="Gerador de MCA", layout="wide")

# 2. Carregamento do Modelo spaCy (Otimizado)
@st.cache_resource
def load_nlp():
    try:
        return spacy.load("pt_core_news_lg")
    except:
        # Fallback caso o nome mude no ambiente virtual
        return spacy.load("pt_core_news_lg")

nlp = load_nlp()

# 3. Base de Dados Técnica (Conforme seus documentos ABNT/CETESB)
DATABASE_MCA = {
    "Fontes": ["Tanque UST", "Tanque AST", "Tubulações", "Aterro", "Lagoa de Efluentes", "Solo Contaminado", "Fase Livre", "Pluma"],
    "Vias": ["Ingestão de Água", "Inalação de Vapores", "Contato Dérmico", "Absorção Radicular"],
    "Receptores": ["Residentes", "Trabalhadores", "Biota Aquática", "Peixes", "Gado"]
}

st.title("🌱 Gerador de Modelo Conceitual (MCA)")
st.markdown("Analise relatórios ambientais e gere o diagrama de fontes, vias e receptores.")

# --- SEÇÃO: EXTRAÇÃO ---
texto_input = st.text_area("Cole o texto do relatório aqui:", height=150)
sugestoes = {"Fontes": [], "Vias": [], "Receptores": []}

if texto_input:
    # Processamento simples de NLP para sugerir termos conhecidos
    texto_min = texto_input.lower()
    for cat, itens in DATABASE_MCA.items():
        for item in itens:
            if item.lower() in texto_min:
                sugestoes[cat].append(item)

# --- SEÇÃO: REFINAMENTO ---
col1, col2, col3 = st.columns(3)
with col1:
    f_sel = st.multiselect("Fontes", DATABASE_MCA["Fontes"], default=sugestoes["Fontes"])
with col2:
    v_sel = st.multiselect("Vias", DATABASE_MCA["Vias"], default=sugestoes["Vias"])
with col3:
    r_sel = st.multiselect("Receptores", DATABASE_MCA["Receptores"], default=sugestoes["Receptores"])

# --- SEÇÃO: DIAGRAMA ---
if st.button("Gerar Diagrama Interativo"):
    if f_sel and v_sel and r_sel:
        net = Network(height="500px", width="100%", directed=True, bgcolor="#ffffff")
        
        # Adicionar nós com cores específicas
        for f in f_sel: net.add_node(f, color="#E63946", shape="dot", size=25)
        for v in v_sel: net.add_node(v, color="#457B9D", shape="box")
        for r in r_sel: net.add_node(r, color="#2A9D8F", shape="diamond")

        # Criar as ligações (Arestas)
        for f in f_sel:
            for v in v_sel: net.add_edge(f, v)
        for v in v_sel:
            for r in r_sel: net.add_edge(v, r)

        # Renderização para Streamlit
        net.save_graph("temp_mca.html")
        with open("temp_mca.html", 'r', encoding='utf-8') as f:
            components.html(f.read(), height=550)
    else:
        st.error("Selecione ao menos um item em cada categoria.")
